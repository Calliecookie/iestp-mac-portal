Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /pagina_no_encontrada.php
AddDefaultCharset UTF-8

<FilesMatch "(?i)^(\.(htaccess|htpasswd|gitignore|gitattributes|DS_Store|env|editorconfig|user\.ini)|(README|LEEME|CHANGELOG|LICENSE)(\.md|\.txt)?|MANUAL_TECNICO_INSTITUCIONAL\.pdf|composer\.(json|lock)|package(-lock)?\.json|php\.ini|error_log|.*\.(md|key|pem|crt|cer|p12|pfx|conf|cfg|yml|yaml|zip|rar|7z|tar|gz|tgz|bz2|bak|backup|old|orig|save|swp|swo|tmp|temp|dist|sql|sqlite|sqlite3|ini|log|lock|sh|bat|ps1|cmd|map|env|inc|phar|phtml)|.*~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_alias.c>
    RedirectMatch 404 (?i)(^|/)\.(?!well-known(/|$))
    RedirectMatch 403 (?i)^/(almacenamiento|configuracion|nucleo|componentes|plantillas|recursos/datos|documentacion|docs)(/.*)?$
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$ [NC]
    RewriteRule ^ - [R=405,L]

    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|acunetix|nessus|openvas|masscan|zgrab|wpscan|dirbuster|gobuster|havij|fimap|netsparker|w3af|jorgee|morfeus|nuclei|httpx|feroxbuster) [NC]
    RewriteRule ^ - [F,L]

    RewriteCond %{THE_REQUEST} (\.\./|\.\.%2f|%2e%2e|%00|%0a|%0d) [NC,OR]
    RewriteCond %{QUERY_STRING} (<|%3c)[^>]*(script|iframe|object|embed|svg|img)[^>]*(>|%3e) [NC,OR]
    RewriteCond %{QUERY_STRING} (javascript|vbscript)(:|%3a) [NC,OR]
    RewriteCond %{QUERY_STRING} (union(\s|%20|\+|/\*)+(all(\s|%20|\+)+)?select|insert(\s|%20|\+)+into|drop(\s|%20|\+)+table|information_schema|load_file\(|into(\s|%20|\+)+outfile|benchmark\(|sleep\() [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_(en|de)code|eval\(|phpinfo\(|GLOBALS(=|\[|%5b)|_REQUEST(=|\[|%5b)|etc/passwd|proc/self/environ|(php|expect|file|zip|phar|data)://) [NC]
    RewriteRule ^ - [F,L]

    RewriteRule (^|/)(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|adminer|vendor/phpunit|cgi-bin)(/|$) - [F,NC,L]
    RewriteRule ^(recursos|almacenamiento)/.*\.(php\d?|phtml|phar|pl|py|cgi)$ - [F,NC,L]

    RewriteRule ^ - [E=MAC_ESQUEMA:https,E=MAC_HOST:%{HTTP_HOST}]
    RewriteCond %{HTTP_HOST} ^www\.iestp-mac\.edu\.pe$ [NC]
    RewriteRule ^ - [E=MAC_HOST:iestp-mac.edu.pe]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ - [E=MAC_ESQUEMA:http]

    RewriteRule ^nosotros\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/historia [R=301,L]
    RewriteRule ^no_mision\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/mision-vision-valores [R=301,L]
    RewriteRule ^no_plana_jerarquica\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/plana-jerarquica [R=301,L]
    RewriteRule ^no_personal_docente\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/personal-docente [R=301,L]
    RewriteRule ^carreras_desarrollo_sistemas\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/desarrollo-de-sistemas [R=301,L]
    RewriteRule ^carreras_enfermeria\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/enfermeria-tecnica [R=301,L]
    RewriteRule ^carreras_industria\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/industria-de-alimentos [R=301,L]
    RewriteRule ^efsrt\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/efsrt [R=301,L]
    RewriteRule ^(ad_admision|ad2026_resultados)\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/admision [R=301,L]
    RewriteRule ^ad_becas\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/becas [R=301,L]
    RewriteRule ^ad_matricula\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/matricula [R=301,L]
    RewriteRule ^ser_educacionales\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/servicios-educacionales [R=301,L]
    RewriteRule ^ser_plataforma\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/plataforma-virtual [R=301,L]
    RewriteRule ^ser_biblioteca\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/biblioteca [R=301,L]
    RewriteRule ^(ser_mesa_de_partes|ser_mpv)\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/mesa-de-partes [R=301,L]
    RewriteRule ^tra_doc_gestion\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/documentos-de-gestion [R=301,L]
    RewriteRule ^tra_tupa\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/tupa [R=301,L]
    RewriteRule ^tra_estadisticas\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/estadisticas [R=301,L]
    RewriteRule ^tra_licenciamiento\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/licenciamiento [R=301,L]
    RewriteRule ^tra_inversiones\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/inversiones [R=301,L]
    RewriteRule ^tra_convenios\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/convenios [R=301,L]
    RewriteRule ^otros_documentos_oficiales\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/archivos-oficiales [R=301,L]
    RewriteRule ^otros_noticias\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/noticias [R=301,L]
    RewriteRule ^(galeria_imagenes|galeria_videos)\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/galeria [R=301,L]
    RewriteRule ^otros_comunicados\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/comunicados [R=301,L]
    RewriteRule ^otros_convocatoria_personal\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/convocatorias [R=301,L]
    RewriteRule ^otros_enlaces\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/enlaces [R=301,L]
    RewriteRule ^contacto\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/contacto [R=301,L]
    RewriteRule ^redes-sociales/videos-youtube\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/api/youtube-videos.php [R=301,L]
    RewriteRule ^redes-sociales/fotos-facebook\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/api/facebook-fotos.php [R=301,L]
    RewriteRule ^redes-sociales/publicaciones-facebook\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/api/facebook-publicaciones.php [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} \s/+[^\s?]+/[\s?]
    RewriteRule ^(.+)/$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/$1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/nosotros/historia\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/historia [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/nosotros/mision-vision-valores\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/mision-vision-valores [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/nosotros/plana-jerarquica\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/plana-jerarquica [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/nosotros/personal-docente\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/personal-docente [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/programas-de-estudio/desarrollo-sistemas\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/desarrollo-de-sistemas [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/programas-de-estudio/enfermeria-tecnica\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/enfermeria-tecnica [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/programas-de-estudio/industria-alimentos\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/industria-de-alimentos [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/programas-de-estudio/efsrt\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/efsrt [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/admision-y-matricula/admision\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/admision [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/admision-y-matricula/becas\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/becas [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/admision-y-matricula/matricula\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/matricula [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/admision-y-matricula/registro-matricula\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/registro-de-matricula [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/admision-y-matricula/calendario\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/calendario [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/servicios/servicios-educacionales\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/servicios-educacionales [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/servicios/plataforma-virtual\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/plataforma-virtual [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/servicios/biblioteca-institucional\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/biblioteca [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/servicios/mesa-de-partes\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/mesa-de-partes [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/servicios/bolsa-laboral\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/bolsa-laboral [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/servicios/libro-reclamaciones\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/libro-de-reclamaciones [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/transparencia/documentos-gestion\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/documentos-de-gestion [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/transparencia/tupa\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/tupa [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/transparencia/estadisticas\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/estadisticas [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/transparencia/licenciamiento\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/licenciamiento [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/transparencia/inversiones\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/inversiones [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/transparencia/convenios\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/convenios [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/otros/archivos-oficiales\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/archivos-oficiales [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/otros/otros-enlaces\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/enlaces [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/otros/noticias\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/noticias [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/otros/comunicados\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/comunicados [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/otros/galeria-multimedia\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/galeria [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/otros/convocatoria-personal\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/convocatorias [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/contacto/contacto\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/contacto [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/contacto/contacto-envio\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/contacto/enviar [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+paginas/privacidad/politica-de-privacidad\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MAC_ESQUEMA}://%{ENV:MAC_HOST}/politica-de-privacidad [R=301,L]

    RewriteRule ^historia/?$ paginas/nosotros/historia.php [L]
    RewriteRule ^mision-vision-valores/?$ paginas/nosotros/mision-vision-valores.php [L]
    RewriteRule ^plana-jerarquica/?$ paginas/nosotros/plana-jerarquica.php [L]
    RewriteRule ^personal-docente/?$ paginas/nosotros/personal-docente.php [L]
    RewriteRule ^desarrollo-de-sistemas/?$ paginas/programas-de-estudio/desarrollo-sistemas.php [L]
    RewriteRule ^enfermeria-tecnica/?$ paginas/programas-de-estudio/enfermeria-tecnica.php [L]
    RewriteRule ^industria-de-alimentos/?$ paginas/programas-de-estudio/industria-alimentos.php [L]
    RewriteRule ^efsrt/?$ paginas/programas-de-estudio/efsrt.php [L]
    RewriteRule ^admision/?$ paginas/admision-y-matricula/admision.php [L]
    RewriteRule ^becas/?$ paginas/admision-y-matricula/becas.php [L]
    RewriteRule ^matricula/?$ paginas/admision-y-matricula/matricula.php [L]
    RewriteRule ^registro-de-matricula/?$ paginas/admision-y-matricula/registro-matricula.php [L]
    RewriteRule ^calendario/?$ paginas/admision-y-matricula/calendario.php [L]
    RewriteRule ^servicios-educacionales/?$ paginas/servicios/servicios-educacionales.php [L]
    RewriteRule ^plataforma-virtual/?$ paginas/servicios/plataforma-virtual.php [L]
    RewriteRule ^biblioteca/?$ paginas/servicios/biblioteca-institucional.php [L]
    RewriteRule ^mesa-de-partes/?$ paginas/servicios/mesa-de-partes.php [L]
    RewriteRule ^bolsa-laboral/?$ paginas/servicios/bolsa-laboral.php [L]
    RewriteRule ^libro-de-reclamaciones/?$ paginas/servicios/libro-reclamaciones.php [L]
    RewriteRule ^documentos-de-gestion/?$ paginas/transparencia/documentos-gestion.php [L]
    RewriteRule ^tupa/?$ paginas/transparencia/tupa.php [L]
    RewriteRule ^estadisticas/?$ paginas/transparencia/estadisticas.php [L]
    RewriteRule ^licenciamiento/?$ paginas/transparencia/licenciamiento.php [L]
    RewriteRule ^inversiones/?$ paginas/transparencia/inversiones.php [L]
    RewriteRule ^convenios/?$ paginas/transparencia/convenios.php [L]
    RewriteRule ^archivos-oficiales/?$ paginas/otros/archivos-oficiales.php [L]
    RewriteRule ^enlaces/?$ paginas/otros/otros-enlaces.php [L]
    RewriteRule ^noticias/?$ paginas/otros/noticias.php [L]
    RewriteRule ^comunicados/?$ paginas/otros/comunicados.php [L]
    RewriteRule ^galeria/?$ paginas/otros/galeria-multimedia.php [L]
    RewriteRule ^convocatorias/?$ paginas/otros/convocatoria-personal.php [L]
    RewriteRule ^contacto/?$ paginas/contacto/contacto.php [L]
    RewriteRule ^contacto/enviar/?$ paginas/contacto/contacto-envio.php [L]
    RewriteRule ^politica-de-privacidad/?$ paginas/privacidad/politica-de-privacidad.php [L]

    RewriteCond %{HTTP_HOST} ^www\.iestp-mac\.edu\.pe$ [NC]
    RewriteRule ^ https://iestp-mac.edu.pe%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType text/calendar .ics
    AddCharset utf-8 .css .js .xml .txt .svg .ics
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/calendar application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/calendar application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "same-site"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-pzQxp92WRzx/SeV1Np9xCqSFFOzBryjU2LRh2fTPosg='; style-src 'self'; font-src 'self'; img-src 'self' data: https:; frame-src https://www.facebook.com https://www.youtube-nocookie.com; connect-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; require-trusted-types-for 'script'; trusted-types mac-recursos"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    <FilesMatch "(?i)\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
